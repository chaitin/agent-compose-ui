# Copy to all-in-one.env only when overrides are needed. With no file, the
# image starts using safe functional defaults and generates its internal
# SCRIPT_SERVICE_TOKEN on first boot under /data.

# UI authentication. For any non-local deployment use password mode and keep
# AUTH_SECRET stable across restarts (for example: openssl rand -hex 32).
AUTH_MODE=disabled
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_TTL=24h

# Optional explicit internal token. Empty means generate and persist one.
SCRIPT_SERVICE_TOKEN=

# Sandbox/runtime selection. The bundled guest image is imported automatically.
RUNTIME_DRIVER=docker
DEFAULT_IMAGE=agent-compose-guest:bundled
DOCKER_DEFAULT_IMAGE=agent-compose-guest:bundled
# SANDBOX_CPUS=4
# SANDBOX_MEMORY_MIB=4096
# SANDBOX_DISK_SIZE_GB=6
# SANDBOX_START_TIMEOUT=30m
# SANDBOX_STOP_TIMEOUT=30s
# JUPYTER_READY_TIMEOUT=30s
# JUPYTER_GUEST_PORT=8888
# JUPYTER_PROXY_BASE=/jupyter
# GUEST_WORKSPACE=/workspace
# GUEST_STATE_ROOT=/data/state
# GUEST_RUNTIME_ROOT=/data/runtime
# GUEST_LOG_ROOT=/data/logs
# SQLITE_MAX_OPEN_CONNS=4

# LLM/provider configuration (optional; project-level settings may override).
LLM_API_ENDPOINT=
LLM_API_PROTOCOL=responses
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
CLAUDE_MODEL=
LLM_TIMEOUT=60s
CODEX_REQUEST_MAX_RETRIES=1
CODEX_STREAM_MAX_RETRIES=1
CODEX_STREAM_IDLE_TIMEOUT=60s

# OAuth (optional).
OAUTH_APIKEY=
OAUTH_SECRET=
OAUTH_BASE_URL=
OAUTH_CALLBACK_URL=
OAUTH_SCOPES=profile
OAUTH_CLIENT_AUTH_METHOD=client_secret_post

# Registry/cache and cleanup (optional).
IMAGE_REGISTRY=docker.io
IMAGE_STORE_MODE=auto
IMAGE_INSECURE_REGISTRIES=
# IMAGE_PULL_TIMEOUT=30m
CACHE_TTL=168h
CLEANUP_INTERVAL=1h
WORKSPACE_CLEANUP_TTL=0
IMAGE_CACHE_CLEANUP_TTL=0

# Operational tuning.
TZ=Asia/Shanghai
AGENT_TIMEOUT=10h
LOADER_RUN_TIMEOUT=20m
# DB_TIMEOUT=30s
WORKSPACE_UPLOAD_LIMIT_BYTES=1073741824
WEBHOOK_BODY_LIMIT_BYTES=1048576
WEBHOOK_QUEUE_DEFAULT_WORKERS=8
# WEBHOOK_QUEUE_RULES_JSON=[]
