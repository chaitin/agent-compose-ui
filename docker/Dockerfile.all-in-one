# syntax=docker/dockerfile:1.7

ARG ENGINE_IMAGE=agent-compose-engine:bundle-build
ARG GUEST_IMAGE=agent-compose-guest:bundle-build
ARG REGISTRY_MIRROR=docker.io
ARG BUN_IMAGE=oven/bun:1

# Build via build-and-up-all-in-one.sh. Its named contexts `engine` and `guest`
# are built from the sibling agent-compose checkout before this final stage.
FROM ${REGISTRY_MIRROR}/library/node:22-alpine AS spa-build
WORKDIR /src
COPY agent-compose-ui/package.json agent-compose-ui/package-lock.json ./
RUN npm ci
COPY agent-compose-ui/ ./
RUN npm run build

FROM ${REGISTRY_MIRROR}/library/golang:1.26-alpine AS gateway-build
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src
COPY agent-compose-ui/go.mod agent-compose-ui/go.sum ./
RUN go mod download
COPY agent-compose-ui/cmd ./cmd
COPY agent-compose-ui/internal ./internal
RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agent-compose-ui-server ./cmd/agent-compose-ui-server

# Compile the daemon from the sibling checkout as well. The published runtime
# base supplies OS/runtime assets, while this stage guarantees that the daemon
# schema and behavior match the UI source shipped in this image. Docker is the
# default deployment driver and needs no external FFI release artifacts.
FROM ${REGISTRY_MIRROR}/library/golang:1.26-alpine AS engine-binary-build
ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache git
WORKDIR /src
COPY agent-compose/go.mod agent-compose/go.sum ./
RUN go mod download
COPY agent-compose/cmd ./cmd
COPY agent-compose/pkg ./pkg
COPY agent-compose/assets ./assets
COPY agent-compose/proto ./proto
ARG ENGINE_VERSION=all-in-one-local
RUN CGO_ENABLED=0 go test -tags netgo,osusergo ./pkg/compose ./pkg/runs && \
    CGO_ENABLED=0 go build -trimpath -tags netgo,osusergo \
      -ldflags="-s -w -X agent-compose/pkg/config.BuildVersion=${ENGINE_VERSION}" \
      -o /out/agent-compose ./cmd/agent-compose && \
    CGO_ENABLED=0 go build -trimpath -tags netgo,osusergo \
      -ldflags="-s -w" -o /out/agent-compose-migrate ./cmd/agent-compose-migrate

FROM ${BUN_IMAGE} AS bun-runtime

# Turn the fully provisioned guest filesystem into a docker-import archive.
# Keeping this in a separate stage prevents the unpacked filesystem from being
# duplicated in the final image layers.
FROM ${GUEST_IMAGE} AS guest-rootfs
FROM ${REGISTRY_MIRROR}/library/debian:bookworm-slim AS guest-archive
RUN sed -i -e 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
      -e 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
      /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends xz-utils && \
    rm -rf /var/lib/apt/lists/*
COPY --from=guest-rootfs / /rootfs/
RUN XZ_OPT='-T0 -1' tar --numeric-owner --xattrs --acls -C /rootfs \
      -cJf /agent-compose-guest.rootfs.tar.xz .

# The engine context is the complete agent-compose daemon runtime image,
# including its Docker, BoxLite and Microsandbox drivers and artifacts.
FROM ${ENGINE_IMAGE} AS runtime
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
      docker-cli nginx wget xz-utils ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
COPY --from=engine-binary-build /out/agent-compose /app/agent-compose
COPY --from=engine-binary-build /out/agent-compose-migrate /usr/local/bin/agent-compose-migrate
COPY --from=spa-build /src/dist /usr/share/nginx/html
COPY --from=gateway-build /out/agent-compose-ui-server /usr/local/bin/
COPY --from=guest-archive /agent-compose-guest.rootfs.tar.xz /opt/agent-compose/images/
COPY agent-compose-ui/script-service/*.mjs /app/script-service/
COPY agent-compose-ui/docker/all-in-one/nginx.conf /etc/nginx/nginx.conf
COPY agent-compose-ui/docker/all-in-one/s6 /etc/s6-overlay/s6-rc.d
COPY agent-compose-ui/docker/all-in-one/entrypoint.sh /usr/local/bin/agent-compose-all-in-one
RUN chmod +x /etc/s6-overlay/s6-rc.d/*/run \
      /etc/s6-overlay/s6-rc.d/prepare/up \
      /usr/local/bin/agent-compose-all-in-one

ENV DATA_ROOT=/data \
    HTTP_LISTEN=0.0.0.0:7410 \
    AGENT_COMPOSE_URL=http://127.0.0.1:7410 \
    AGENT_COMPOSE_RUNTIME_BASE_URL=http://agent-compose:7410 \
    BUNDLED_GUEST_IMAGE=agent-compose-guest:bundled \
    DEFAULT_IMAGE=agent-compose-guest:bundled \
    DOCKER_DEFAULT_IMAGE=agent-compose-guest:bundled \
    RUNTIME_DRIVER=docker \
    CAP_GRPC_LISTEN=0.0.0.0:9100 \
    CAP_GRPC_TARGET=agent-compose:9100 \
    SCRIPT_SERVICE_URL=http://127.0.0.1:7420 \
    SCRIPT_SERVICE_HOST=127.0.0.1 \
    SCRIPT_SERVICE_PORT=7420 \
    SCRIPT_DATA_DIR=/data/scripts \
    AGENT_COMPOSE_DB_PATH=/data/data.db \
    UI_STATE_DB_PATH=/data/ui/project-env.db \
    TOKEN_DB_PATH=/data/api/tokens.db \
    PROJECT_STORAGE_ROOT=/data/work/projects \
    AUTH_MODE=disabled \
    AUTH_USERNAME=admin \
    AUTH_SESSION_TTL=24h \
    S6_VERBOSITY=1

VOLUME ["/data"]
EXPOSE 80 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 \
  CMD wget -qO /dev/null http://127.0.0.1/api/version || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-compose-all-in-one"]
