#!/bin/sh
set -eu
umask 077
mkdir -p /data/work/projects /data/sandboxes /data/scripts /data/ui /data/api /run/agent-compose
if [ -z "${SCRIPT_SERVICE_TOKEN:-}" ]; then
  token_file=/data/.script-service-token
  if [ ! -s "$token_file" ]; then
    openssl rand -hex 32 > "$token_file"
  fi
  printf 'SCRIPT_SERVICE_TOKEN=%s\n' "$(cat "$token_file")" > /run/agent-compose/internal.env
else
  printf 'SCRIPT_SERVICE_TOKEN=%s\n' "$SCRIPT_SERVICE_TOKEN" > /run/agent-compose/internal.env
fi
chmod 600 /run/agent-compose/internal.env

bundled_guest_image=${BUNDLED_GUEST_IMAGE:-agent-compose-guest:bundled}
if ! docker image inspect "$bundled_guest_image" >/dev/null 2>&1; then
  xz -dc /opt/agent-compose/images/agent-compose-guest.rootfs.tar.xz | \
    docker import \
      --change 'ENTRYPOINT ["/usr/bin/tini","--"]' \
      --change 'CMD ["/usr/local/bin/agent-compose-env","bash","-lc","sleep infinity"]' \
      --change 'ENV HOME=/root' \
      --change 'ENV OPENCODE_DISABLE_AUTOUPDATE=true' \
      --change 'ENV OPENCODE_DISABLE_MODELS_FETCH=1' \
      --change 'ENV PATH=/root/.local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
      - "$bundled_guest_image" >/dev/null
fi
