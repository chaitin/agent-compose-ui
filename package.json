{
  "name": "agent-compose-ui",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build:ui": "vite build",
    "dev:ui": "vite",
    "gen:api": "rm -rf src/gen && mkdir -p src/gen && protoc --plugin=./node_modules/.bin/protoc-gen-es --plugin=./node_modules/.bin/protoc-gen-connect-es -I ../agent-compose/proto --es_out src/gen --es_opt target=ts,import_extension=.js --connect-es_out src/gen --connect-es_opt target=ts,import_extension=.js health/v1/health.proto agentcompose/v2/agentcompose.proto && node scripts/normalize-generated-eof.mjs src/gen",
    "check:ui": "svelte-check --tsconfig ./tsconfig.check.json && vite build",
    "format:check": "prettier --check 'src/**/*.{svelte,ts}' '*.{json,ts}'",
    "format": "prettier --write 'src/**/*.{svelte,ts}' '*.{json,ts}'",
    "test:e2e": "playwright test",
    "check:server": "go test ./...",
    "build:image": "docker build -f nginx/Dockerfile -t agent-compose-ui:local ."
  },
  "dependencies": {
    "@ant-design/icons-svg": "^4.4.2",
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.38.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
